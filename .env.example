# 複製成 .env 後填入實際值（.env 已在 .gitignore，不會進 Git）。
# 各變數用途與取得方式見 docs/部署與設定.md

# ── Supabase（Nuxt 版專用的新專案）──
NUXT_SUPABASE_URL=https://eetmnranpbdkolzgbimj.supabase.co
# Supabase 後台 → Project Settings → API Keys → service_role（或 secret key）
# ⚠️ 繞過所有資料表權限，只放伺服器端、絕不可提交或公開
NUXT_SUPABASE_SERVICE_ROLE_KEY=

# ── 登入憑證 ──
# 至少 32 字元的隨機字串。產生方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NUXT_SESSION_SECRET=

# ── LINE ──
# LINE Developers → LINE Login channel → Basic settings → Channel ID（與正式版同一個 channel）
NUXT_LINE_CHANNEL_ID=
# 該 channel 底下「為 Nuxt 版新建的 LIFF app」的 LIFF ID
NUXT_PUBLIC_LIFF_ID=

# ── 本機開發用測試登入（只在 pnpm dev 有效，正式建置一律關閉）──
NUXT_DEV_LOGIN=1
NUXT_PUBLIC_DEV_LOGIN=1
